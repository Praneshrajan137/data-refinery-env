# Build artifacts and caches
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
.env

# Version control
.git/
.gitignore

# Development-only files (not needed in container)
Makefile

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation (not needed in container)
LICENSE
CHANGELOG.md

# NOTE: README.md is NOT excluded — HuggingFace Spaces reads it for the landing page
# NOTE: uv.lock is NOT excluded — Dockerfile uses it for reproducible frozen builds
# NOTE: the root datasets/ directory used to be preserved here for the legacy hackathon
#   environment, which loaded task fixtures from it at runtime. Both are gone as of
#   2026-08-27; dataforge.env resolves its fixtures from the PACKAGED dataforge/fixtures
#   and dataforge/datasets/embedded instead, which ship inside the wheel.

# Large trees NOT needed in the backend image (keeps the ACR/HF build context small).
# The Dockerfile only copies playground/api, pyproject.toml, README.md, dataforge/, constitutions/.
playground/web/
eval/
training/
tests/
docs/
notebooks/
*.ipynb
scripts/
specs/
packages/
dataforge-mcp/
.hf-space-repo/
.hf-space-stage/
site/

