# DataForge environment template -- SAFE TO COMMIT. Contains no secrets.
#
# Copy to `.env` (gitignored) and fill in real values:
#   Copy-Item .env.example .env        # PowerShell
#   cp .env.example .env               # bash
#
# Before this file existed, the required variables were documented only in prose
# across two runbooks, so there was no machine-checkable list. The contract test
# `tests/unit/test_env_contract.py` now derives its expectations from the code:
# every priced (billable) provider in `dataforge.spend.PRICES` must have a
# documented USD cap here, and every implemented provider must have its
# credential documented. Adding a metered provider without documenting its cap
# fails CI.
#
# NOTHING here is required to run DataForge's default path. The deterministic
# pipeline, the verifier, the reversible journal, and the certificate are all
# fully offline. These variables only enable the optional LLM surfaces.

# =============================================================================
# Provider selection
# =============================================================================
# One of: groq | grok | cerebras | gemini | bedrock | azure
# When unset, the first provider with a credential present is used.
DATAFORGE_LLM_PROVIDER=azure

# =============================================================================
# Spend controls -- READ THIS BEFORE ANY PAID RUN
# =============================================================================
# Three independent guards protect against overspend:
#   1. Pre-flight   -- the estimated cost of a planned run is refused up front.
#   2. In-flight    -- a hard stop the moment cumulative spend crosses the cap.
#   3. After-the-fact -- a receipt appended to eval/results/spend_ledger.json.
#
# Global cap. Applies to every provider, including the product/agent path
# (`dataforge repair --agent`), which had no cap at all before.
# A value of 0 disables the guard (explicitly unmetered).
DATAFORGE_MAX_USD=50

# Per-provider caps override the global cap for that provider.
DATAFORGE_AZURE_MAX_USD=15
DATAFORGE_BEDROCK_MAX_USD=15
DATAFORGE_GEMINI_MAX_USD=15
DATAFORGE_GROK_MAX_USD=15

# Price overrides (USD per 1000 tokens). Defaults in `dataforge/spend.py` are
# deliberately conservative (high) so the guard trips early rather than late.
# DATAFORGE_AZURE_USD_PER_1K_INPUT=0.005
# DATAFORGE_AZURE_USD_PER_1K_OUTPUT=0.015

# =============================================================================
# Azure OpenAI (first-party, billed to the subscription, works on trial credit)
# =============================================================================
AZURE_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# NOTE: this is the *deployment name*, not the model id.
DATAFORGE_AZURE_MODEL=
# Reasoning deployments spend hidden reasoning tokens against this budget, so a
# too-small cap yields empty content. The runbook uses 2048.
DATAFORGE_AZURE_MAX_TOKENS=2048
# Raise for reasoning deployments; a slow request otherwise aborts a paid run.
DATAFORGE_AZURE_TIMEOUT_S=180
# One of: none | minimal | low | medium | high | xhigh (model-dependent).
# 'none' is the cheapest and fastest on GPT-5.6-series deployments.
DATAFORGE_AZURE_REASONING_EFFORT=
# Reasoning models do NOT support `temperature` and reject temperature != 1, so
# it is omitted unless this is truthy. Leave unset for GPT-5-family deployments.
DATAFORGE_AZURE_SEND_TEMPERATURE=

# =============================================================================
# Other providers
# =============================================================================
GROQ_API_KEY=
DATAFORGE_GROQ_MODEL=

XAI_API_KEY=
DATAFORGE_GROK_MODEL=

CEREBRAS_API_KEY=
DATAFORGE_CEREBRAS_MODEL=

GEMINI_API_KEY=
DATAFORGE_GEMINI_MODEL=

AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
DATAFORGE_BEDROCK_MODEL=

# =============================================================================
# Benchmark knobs
# =============================================================================
# Cap the number of detected issues sent to the LLM corrector per episode. The
# single most effective way to bound the cost of a corrector run.
DATAFORGE_CORRECTOR_MAX_ISSUES=30
# Committing a cache directory lets a paid run replay byte-identically offline
# with no API key -- the basis for reproducible calibration artifacts.
DATAFORGE_CORRECTOR_CACHE_DIR=
DATAFORGE_BENCH_VERBOSE=

# =============================================================================
# Playground / deployment (not needed for local use)
# =============================================================================
DATAFORGE_PLAYGROUND_ORIGINS=
DATAFORGE_PLAYGROUND_AGENT_POLICY=
DATAFORGE_REMOTE_MODEL_URL=
DATAFORGE_REMOTE_MODEL_TOKEN=
HF_TOKEN=
